# Supabase project URL. Local: http://127.0.0.1:54421 (see supabase/config.toml [api] port).
# Production/preview: Supabase project dashboard > Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...), safe for client-side use.
# Local: get it from `supabase status` on the local stack. Production/preview: Supabase
# dashboard > Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...), server only, never exposed to the client.
# Local: get it from `supabase status` on the local stack. Production/preview: Supabase
# dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=

# Postgres connection string read by drizzle-kit (see drizzle.config.ts dbCredentials.url).
# Local: get it from `supabase status` on the local stack (DB port is 54422, see
# supabase/config.toml [db] port). Production/preview: Supabase dashboard > Project Settings
# > Database > Connection string.
DATABASE_URL=
